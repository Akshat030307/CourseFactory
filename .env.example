# cp .env.example .env  — only GROQ_API_KEY and OPENAI_API_KEY are needed to start.

# ---------------------------------------------------------------- database
# Port 5433, not the default 5432 — another project on this machine already
# holds 5432 (mesh-postgres-1). Check `docker ps` before assuming 5432 is free.
DATABASE_URL=postgresql://coursefactory:coursefactory@localhost:5433/coursefactory

# ------------------------------------------------------------------ models
# Groq: free tier, OpenAI-compatible endpoint. Most traffic goes here.
# Generous on requests, TIGHT on tokens/min (~12K on 70B). Long-context work
# goes to OpenAI, not Groq.  https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
# llama-3.1-8b-instant and llama-3.3-70b-versatile (the original values for
# FAST/SMART) both 404 as of D1 (Stage 8) — checked Groq's live /models list
# rather than guess a replacement. Neither had been called by any code until
# mcp_server.py became the first real caller of a Groq "smart" text model, so
# nothing caught this earlier. llama-4-scout was deprecated by Groq on
# 2026-06-17 (404s on call) — found running B3. qwen/qwen3.6-27b is the
# current Groq vision/OCR model as of
# 2026-08-21; verify again if this starts 404ing too, model lineup moves fast.
GROQ_MODEL_VISION=qwen/qwen3.6-27b
GROQ_MODEL_ASR=whisper-large-v3-turbo

# OpenAI: long-context analysis + embeddings. Verify the current nano-tier
# model name and pricing — these move.
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-5-nano
OPENAI_MODEL_EMBED=text-embedding-3-small

# ------------------------------------------------------------- free tiers
# All require registration, none require a card. Skip until the stage needs them.
DEEPL_API_KEY=            # 500K chars/month free
COHERE_API_KEY=           # trial key, rate-limited
TWELVELABS_API_KEY=       # free tier indexing minutes
TELEGRAM_BOT_TOKEN=       # @BotFather. Long polling — no tunnel needed.

# ----------------------------------------------------------------- service
# RocketRide's local engine (run by its VS Code extension, "Local" connection
# mode) does NOT default to a fixed port — it's started with --port=0, so it
# gets a new OS-assigned port on every restart. Find the current one with
# `netstat -ano | findstr LISTENING` on engine.exe's PID, then
# `curl http://localhost:<port>/version` to confirm, and update both lines
# below. The API key itself does NOT come from the VS Code extension at all —
# its Settings UI never exposes one, in any tab or mode. Get it from the
# RocketRide Cloud dashboard (cloud.rocketride.ai) instead: it's account-scoped,
# not deployment-scoped, so a Cloud-issued key authenticates fine against the
# local engine here. Both ROCKETRIDE_URI and ROCKETRIDE_APIKEY are required —
# the RocketRide SDK reads exactly those two names, not ROCKETRIDE_URL.
ROCKETRIDE_URL=http://localhost:<current-port>
ROCKETRIDE_URI=http://localhost:<current-port>
ROCKETRIDE_APIKEY=
# Only ROCKETRIDE_-prefixed vars are substitutable inside pipeline JSON
# (as "${ROCKETRIDE_GROQ_API_KEY}"), so it's duplicated here alongside the
# plain GROQ_API_KEY that host-side scripts (scripts/ingest.py) read directly.
ROCKETRIDE_GROQ_API_KEY=${GROQ_API_KEY}
EDGE_TTS_URL=http://localhost:5002
MEDIA_ROOT=./media
PUBLIC_HOST=http://localhost:5173
DEMO_STUDENT_ID=s1

# ------------------------------------------------------------ cost guards
FRAME_INTERVAL_SEC=5
MAX_VISION_FRAMES=150     # hard cap regardless of dedup output
DEDUP_HAMMING_THRESHOLD=18 # tuned against real Strang footage (B2) — median of per-tile Hamming distances (4x4 grid, 36 max/tile), not a whole-frame hash. See scripts/ingest.py tiled_hashes().
MAX_CONTEXT_TOKENS=2000   # after rerank; cost AND quality control
REMEDIATION_MAX_HOPS=3

# ------------------------------------------------------------------ auth
# Stage 13 — VPS deployment. Gates the whole app (gateway/app/auth.py);
# see docs/DEPLOYMENT.md for how to actually generate these before going
# live. Leave AUTH_USERNAME/AUTH_PASSWORD_HASH blank and every route 401s —
# fine for local dev if you never call scripts/ingest.py, useless once
# anything needs to hit the API.
AUTH_USERNAME=
# base64-encoded bcrypt hash, NOT the raw "$2b$12$..." string — a literal $
# in a Docker Compose env_file value gets silently corrupted by Compose's
# own variable interpolation (verified this the hard way — see CLAUDE.md's
# Stage 13 notes). docs/DEPLOYMENT.md has the one-liner that generates the
# base64 form directly, so you never have to think about this.
AUTH_PASSWORD_HASH_B64=
JWT_SECRET=               # long random string — `python -c "import secrets; print(secrets.token_hex(32))"`
# Lets scripts/telegram_bot.py and scripts/mcp_server.py call the gateway's
# API without a browser login (they're the only two scripts that call it at
# all — everything else talks to Postgres directly). Same generation
# command as JWT_SECRET, a separate random value.
SERVICE_API_KEY=
# Secure cookies are dropped by browsers over plain HTTP — true is correct
# for the real VPS deployment (Caddy terminates real HTTPS via DOMAIN
# below). Only set this to false to test the login flow locally against
# `npm run dev` over http://localhost.
COOKIE_SECURE=true

# ------------------------------------------------------ VPS deployment only
# Not read by local dev (docker-compose.yml doesn't reference these) — only
# by docker-compose.prod.yml. See docs/DEPLOYMENT.md.
POSTGRES_PASSWORD=        # real random password — the local dev "coursefactory" default is not safe to reuse here
DOMAIN=                   # a real domain already pointed at this VPS's IP, or the bare IP for a first HTTP-only smoke test
